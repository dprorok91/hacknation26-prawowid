{
  "manifest_version": 3,
  "name": "VeriFrame — Fact-Check & Framing Inspector",
  "version": "1.0.0",
  "description": "Inspects factual claims and media framing in a docked side panel with subtle inline underlines.",
  "permissions": ["sidePanel", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open VeriFrame Inspector"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}