# Local development defaults only. Never commit real credentials.
POSTGRES_DB=prawdowid
POSTGRES_USER=prawdowid
POSTGRES_PASSWORD=prawdowid_dev_password
PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Optional public news fallback. Free tier is delayed ~12h; disabled by default.
DISCOVERY_CACHE_HOURS=12
ENABLE_NEWSDATA_FALLBACK=false
NEWSDATA_DAILY_CREDIT_BUDGET=20
# NEWSDATA_API_KEY=your_key_here

# Optional model for approved public articles submitted via /analyses.
PUBLIC_LLM_PROVIDER='ollama'
OPENROUTER_MODEL=openai/gpt-4.1-mini
OPENROUTER_API_KEY=''
# OPENROUTER_API_KEY=  # Supply only to the backend worker.
